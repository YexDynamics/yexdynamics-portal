# 1. Configuración general
spring.application.name=portal-indie
server.port=8080

# 2. Base de datos (PostgreSQL en Docker)
spring.datasource.url=jdbc:postgresql://localhost:5432/portal_db
spring.datasource.username=devuser
spring.datasource.password=devpassword
spring.datasource.driver-class-name=org.postgresql.Driver

# 3. JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# 4. CORS — orígenes permitidos (para cuando conectes el frontend/Angular)
security.cors.allowed-origins=http://localhost:4200ocalhost:4200ibernate.dialect.PostgreSQLDialect